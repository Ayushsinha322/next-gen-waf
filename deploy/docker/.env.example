# Next-Gen ESDS WAF — deploy environment template.
# Copy to `.env` (same directory) and fill every value. `.env` is gitignored and
# MUST be 0600. `docker compose` auto-loads it (project dir = this folder).
#
# The control-plane binary FAILS FAST at boot if any *boot-fatal* key below is
# missing or too weak — a stale/incomplete .env is what crash-loops the cluster.
# Run ./preflight.sh before `up` to catch that before it hits runtime.

# ── Postgres (system of record) ─────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
POSTGRES_PASSWORD=            # strong random
# Full DSN the control plane connects with (superuser 'sentinel' in single-tenant demo).
SENTINEL_DB_URL=postgres://sentinel:CHANGEME@postgres:5432/sentinel?sslmode=disable

# ── Boot-fatal secrets (controllerd refuses to start without these) ─────────
SENTINEL_JWT_SECRET=          # >=32 chars   — openssl rand -hex 32
SENTINEL_AUDIT_HMAC_KEY=      # >=32 chars   — openssl rand -hex 32
SENTINEL_INTERNAL_SECRET=     # >=32 chars   — openssl rand -hex 32 (control-plane <-> data-plane)
# Multi-node cluster ONLY: authenticates inter-node Raft RPC. >=32 chars and NOT
# the string 'demo-raft-cluster-secret'. openssl rand -hex 32
SENTINEL_RAFT_SECRET=
# Single-tenant demo posture: allow connecting to Postgres as a superuser role
# (bypasses FORCE RLS). Set to 1, OR point SENTINEL_DB_URL at the non-superuser
# 'sentinel_app' role and remove this. Boot-fatal if a superuser DSN is used
# without this opt-in.
SENTINEL_ALLOW_SUPERUSER_DB=1

# ── ClickHouse (Threat Search / event history) ──────────────────────────────
CLICKHOUSE_USER=sentinel
CLICKHOUSE_DB=sentinel_logs
CLICKHOUSE_PASSWORD=          # strong random

# ── Storage tuning (all optional — sane defaults if unset) ───────────────────
# How long the searchable attack log is kept (data plane applies it to ClickHouse).
# Raise for compliance (e.g. 365); lower to save disk. Clamped 1..3650 days.
SENTINEL_CLICKHOUSE_EVENT_RETENTION_DAYS=90     # waf_events (attacks) — default 90
SENTINEL_CLICKHOUSE_TRAFFIC_RETENTION_DAYS=30   # traffic_buckets (stats) — default 30
# Disk-pressure alert: the control plane pages the SOC (via notification channels)
# when the ClickHouse disk crosses this used-percent. Escalates 80→90(high)→95(crit).
SENTINEL_DISK_ALERT_PCT=80                       # default 80
SENTINEL_DISK_CHECK_SECS=300                     # poll interval — default 300s
