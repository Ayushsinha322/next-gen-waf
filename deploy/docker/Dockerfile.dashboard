FROM node:22.23.4-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci || npm install

FROM node:22.23.4-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Next.js bakes BOTH the rewrite() destination AND NEXT_PUBLIC_* client vars at
# BUILD time. Two distinct URLs:
#   CONTROL_PLANE_URL            → server-side REST proxy, internal hostname (portable)
#   NEXT_PUBLIC_CONTROL_PLANE_URL → client-side SSE log stream override
#
# The SSE default is EMPTY on purpose, which makes the stream same-origin (see
# dashboard/lib/api.ts logs.streamURL). The old default was
# http://controlplane:9501 — a DOCKER-INTERNAL hostname that a browser can never
# resolve, so any build that forgot to pass the arg produced an image whose live
# log tail could not work anywhere. Empty is both the safe default and the
# correct one: the management console proxies /api/* to the control plane, so a
# relative URL reaches it unbuffered from whatever origin the console is on.
#
# Set it only for an origin that does NOT proxy /api — e.g. the cleartext :3000
# break-glass path, where Next's rewrite buffers SSE.
ARG CONTROL_PLANE_URL=http://controlplane:9501
ARG NEXT_PUBLIC_CONTROL_PLANE_URL=
ENV CONTROL_PLANE_URL=${CONTROL_PLANE_URL}
ENV NEXT_PUBLIC_CONTROL_PLANE_URL=${NEXT_PUBLIC_CONTROL_PLANE_URL}
RUN npm run build

FROM node:22.23.4-alpine AS runner
# Build provenance — see the long note in deploy/docker/Dockerfile. Re-declared
# here because an ARG is scoped to the stage that names it.
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
ARG VERSION=0.0.0
LABEL org.opencontainers.image.title="Swaraj Kavach dashboard" \
      org.opencontainers.image.revision="$GIT_SHA" \
      org.opencontainers.image.created="$BUILD_DATE" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.source="https://git.enlight.dev/research-lab/SIG-CyberSec/sentinel-waf"
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# Standalone runtime — see `output: "standalone"` in dashboard/next.config.js.
#
# This stage used to copy the whole builder tree: /app/.next (136 MB, of which
# 133 MB is .next/cache — webpack build artefacts that are never read at
# runtime) and /app/node_modules (588 MB, containing TypeScript, ESLint,
# Tailwind, vitest and the Next compiler). The result was a 779 MB image next to
# 46-55 MB for dataplane/controlplane/migrate, and it was single-handedly
# responsible for the offline bundle needing a four-part split to clear this
# GitLab's ~250 MB upload cap.
#
# Next traces the modules the server actually reaches and emits them under
# .next/standalone. Three directories are all the runtime needs:
#
#   .next/standalone -> server.js + the traced subset of node_modules
#   .next/static     -> hashed client chunks, served at /_next/static
#   public           -> static assets served from /
#
# .next/static is NOT inside standalone and is NOT optional: omit it and the
# app returns HTML whose every script and stylesheet 404s — a blank page with a
# 200 status, which looks like an application bug rather than a packaging one.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
# Bind all interfaces. The standalone server defaults HOSTNAME to localhost in
# some Next builds, which inside a container means nothing outside it can
# connect — the published port and the compose-network name both dead-end on a
# container that is running and healthy-looking.
ENV PORT=3000 \
    HOSTNAME=0.0.0.0
# `npm start` runs `next start`, which standalone output does not support (and
# npm is not even present in the traced tree). The server is a plain node entry
# point now.
CMD ["node", "server.js"]
