# /etc/sentinel/backup.env — read by sentinel-backup.service. install.sh writes
# this for a package install; edit it to add an offsite target.

# Where backup.sh lives. Package install: /opt/sentinel/current/scripts/backup
# (a repository checkout: <checkout>/deploy/backup).
SENTINEL_BACKUP_DIR=/opt/sentinel/current/scripts/backup

# Where compose + creds live.
COMPOSE_FILE=/opt/sentinel/current/compose.prod.yml
ENV_FILE=/opt/sentinel/current/.env

# Local staging + retention. The directory is made root-only (0700).
BACKUP_ROOT=/var/backups/sentinel
RETENTION_DAYS=14

# ── Encryption ──────────────────────────────────────────────────────────────
# Every backup is encrypted with gpg (AES-256) under the passphrase in this file,
# created on the first backup. It is NOT inside any backup: keep a copy off this
# host (a password manager, a vault). Without it no backup can be restored.
BACKUP_KEY_FILE=/etc/sentinel/backup.key
# Or encrypt to a public key instead, so the private key never has to be on this
# host: gpg --import it into root's keyring and name it here.
BACKUP_GPG_RECIPIENT=

# ── Offsite: configure EXACTLY ONE (leaving both blank = NOT disaster-safe) ──
# rclone (recommended; supports S3/GCS/Azure/B2/SFTP). Remote must be preconfigured
# in root's rclone.conf (run `rclone config` as root first).
BACKUP_RCLONE_REMOTE=
# e.g. BACKUP_RCLONE_REMOTE=s3prod:sentinel-backups/waf-node-1

# rsync over SSH (key-based auth set up for root).
BACKUP_RSYNC_DEST=
# e.g. BACKUP_RSYNC_DEST=backup@nas.internal:/vol/sentinel
