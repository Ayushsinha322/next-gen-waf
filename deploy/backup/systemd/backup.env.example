# Copy to /etc/sentinel/backup.env and edit. Read by sentinel-backup.service.

# Absolute path to the Sentinel repo checkout on this host (holds deploy/docker/compose.prod.yml).
SENTINEL_REPO=/opt/sentinel-waf

# Where compose + creds live (defaults derive from SENTINEL_REPO if unset).
COMPOSE_FILE=/opt/sentinel-waf/deploy/docker/compose.prod.yml
ENV_FILE=/opt/sentinel-waf/deploy/docker/.env

# Local staging + retention.
BACKUP_ROOT=/var/backups/sentinel
RETENTION_DAYS=14

# ── Offsite: configure EXACTLY ONE (leaving both blank = NOT disaster-safe) ──
# rclone (recommended; supports S3/GCS/Azure/B2/SFTP). Remote must be preconfigured
# in the invoking user's rclone.conf (run `rclone config` as that user first).
BACKUP_RCLONE_REMOTE=
# e.g. BACKUP_RCLONE_REMOTE=s3prod:sentinel-backups/$(hostname)

# rsync over SSH (key-based auth set up for the service user).
BACKUP_RSYNC_DEST=
# e.g. BACKUP_RSYNC_DEST=backup@nas.internal:/vol/sentinel
