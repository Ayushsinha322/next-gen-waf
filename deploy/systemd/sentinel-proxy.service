[Unit]
Description=Sentinel WAF — Data Plane Proxy
Documentation=https://github.com/your-org/sentinel-waf
After=network-online.target sentinel-controlplane.service
Wants=network-online.target sentinel-controlplane.service

[Service]
Type=notify
User=sentinel
Group=sentinel
ExecStart=/opt/sentinel/sentinel-bin
Restart=always
RestartSec=5

# Soft memory guardrail only — the data plane is the critical traffic path, so
# we let the kernel reclaim past this hint rather than hard-kill under a spike.
# Tune up for high-traffic VMs (e.g. MemoryHigh=2G).
MemoryHigh=1G

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/sentinel /var/log/sentinel
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Environment=SENTINEL_CONFIG=/etc/sentinel/sentinel.yaml
Environment=SENTINEL_LOG_DIR=/var/log/sentinel
# `sentinel=debug` did the OPPOSITE of what it looks like: it silenced the whole
# sentinel-modules crate (geoip, bot_detect, dlp, jwt_auth, anti_ddos,
# rate_limit, ip_reputation, threat_intel, smuggling, tls_fingerprint, graphql,
# grpc) instead of raising its level, because `sentinel` is not a module-path
# prefix of `sentinel_modules`. Someone asking for more logging got none.
# For a per-crate level, name the crate exactly: sentinel_modules=debug.
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

# Bind to privileged ports (80/443) without root via ambient capabilities
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target